{
  "name": "dsh-color",
  "version": "0.2.3",
  "description": "Color toolbox for DeepSeek Harness (dsh): parse and convert any CSS color (hex / rgb / hsl / hwb / named), WCAG contrast ratios with AA/AAA verdicts, named-color lookup, harmonious palette generation (complementary / analogous / triadic / split-complementary / tetradic / square / monochromatic), and color adjustments (lighten / darken / saturate / desaturate / hue-rotate) — zero runtime dependencies, pure math",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint src test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "color",
    "css",
    "hex",
    "hsl",
    "hwb",
    "wcag",
    "contrast",
    "accessibility",
    "palette",
    "color-scheme",
    "harmony"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TYEclipse/dsh-color.git"
  },
  "bugs": {
    "url": "https://github.com/TYEclipse/dsh-color/issues"
  },
  "homepage": "https://github.com/TYEclipse/dsh-color#readme",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "3.2.0",
    "oxlint": "^1.6.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
